{
  "name": "sub-manager-frontend",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "engines": {
    "node": ">=20 <25",
    "npm": ">=10 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run i18n:check && npx --no-install tsc && npx --no-install vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "i18n:baseline": "node scripts/i18n-hardcoded-check.mjs --write-baseline",
    "i18n:check": "node scripts/i18n-hardcoded-check.mjs"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "chart.js": "^4.5.1",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.487.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.5.4"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.15.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^6.4.2",
    "vitest": "^3.2.7"
  }
}
