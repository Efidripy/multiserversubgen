{
  "$meta": {
    "name": "multiserversubgen Design Tokens",
    "version": "2.0.0",
    "description": "Single source of truth for all visual decisions",
    "theme": "dark-first, light supported"
  },

  "color": {
    "brand": {
      "cyan":   { "value": "#0dcfba", "css": "var(--accent)",   "usage": "Primary CTA, active state, focus ring" },
      "purple": { "value": "#a78bfa", "css": "var(--accent-2)", "usage": "Secondary actions, info, reset-traffic" }
    },
    "semantic": {
      "success": { "dark": "#0dbc8f", "light": "#0d9960", "usage": "Active status, enable, positive feedback" },
      "warning": { "dark": "#f59e0b", "light": "#c47b0a", "usage": "Expiring soon, freeze, depleted" },
      "danger":  { "dark": "#ef4444", "light": "#dc2626", "usage": "Delete, expired, critical" },
      "info":    { "note": "Deprecated — use accent-2 (#a78bfa) instead" }
    },
    "neutral": {
      "bg-0": { "dark": "#0b1120", "light": "#f0f4f9",   "css": "var(--bg-primary)" },
      "bg-1": { "dark": "#111a2e", "light": "#ffffff",   "css": "var(--bg-secondary)" },
      "bg-2": { "dark": "#182035", "light": "#e8eef6",   "css": "var(--bg-tertiary)" },
      "border":{ "dark": "#1e3048", "light": "#c8d8ea",  "css": "var(--border-color)" },
      "text-0":{ "dark": "#e8f1fb", "light": "#0f1f33",  "css": "var(--text-primary)" },
      "text-1":{ "dark": "#7a93ad", "light": "#4a607a",  "css": "var(--text-secondary)" },
      "text-2":{ "dark": "#4a6070", "light": "#7a93ad",  "css": "var(--text-tertiary)" }
    }
  },

  "spacing": {
    "_rule": "4px base grid. All spacing MUST be a multiple of 4.",
    "1": "4px",   "2": "8px",   "3": "12px",  "4": "16px",
    "5": "20px",  "6": "24px",  "8": "32px",  "10": "40px",
    "12": "48px", "16": "64px"
  },

  "radius": {
    "_rule": "No arbitrary values. Use only these.",
    "sm":   "6px",
    "md":   "8px",
    "lg":   "12px",
    "xl":   "14px",
    "2xl":  "16px",
    "full": "9999px"
  },

  "typography": {
    "fontFamily": {
      "sans":    "IBM Plex Sans, Segoe UI, system-ui",
      "display": "Sora, IBM Plex Sans, system-ui",
      "mono":    "JetBrains Mono, Fira Code, Consolas, monospace"
    },
    "scale": {
      "xs":   { "size": "0.68rem", "lh": 1.4  },
      "sm":   { "size": "0.75rem", "lh": 1.45 },
      "base": { "size": "0.84rem", "lh": 1.5  },
      "md":   { "size": "0.95rem", "lh": 1.45 },
      "lg":   { "size": "1.1rem",  "lh": 1.3  },
      "xl":   { "size": "1.3rem",  "lh": 1.2  },
      "2xl":  { "size": "1.6rem",  "lh": 1.15 }
    },
    "weight": { "normal": 400, "medium": 500, "semibold": 600, "bold": 700 }
  },

  "shadow": {
    "sm":  "0 2px 8px rgba(0,0,0,0.18)",
    "md":  "0 6px 24px rgba(0,0,0,0.28)",
    "lg":  "0 12px 40px rgba(0,0,0,0.35)",
    "xl":  "0 24px 60px rgba(0,0,0,0.45)",
    "glow":"0 0 0 3px color-mix(in srgb, var(--accent) 20%, transparent)"
  },

  "animation": {
    "duration": { "instant": "80ms", "fast": "150ms", "normal": "220ms", "slow": "350ms" },
    "easing": {
      "standard":   "cubic-bezier(0.4, 0, 0.2, 1)",
      "decelerate": "cubic-bezier(0.0, 0.0, 0.2, 1)",
      "spring":     "cubic-bezier(0.22, 1, 0.36, 1)"
    }
  },

  "breakpoints": { "sm": "520px", "md": "768px", "lg": "1024px", "xl": "1200px" }
}
