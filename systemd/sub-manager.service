[Unit]
Description=Multi-Server Sub Manager Service
After=network.target

[Service]
User=__PROJECT_NAME__
Group=__PROJECT_NAME__
UMask=0077
WorkingDirectory=/opt/sub-manager
EnvironmentFile=/etc/__PROJECT_NAME__/runtime-secrets.env
Environment="REQUIRE_PERSISTENT_SECRETS=true"
Environment="PROJECT_DIR=/opt/sub-manager"
Environment="APP_PORT=666"
Environment="CACHE_TTL=30"
Environment="WEB_PATH=my-panel"
Environment="GRAFANA_WEB_PATH=grafana"
Environment="MONITORING_ENABLED=true"
Environment="ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173"
Environment="VERIFY_TLS=true"
Environment="CA_BUNDLE_PATH="
Environment="XUI_CONNECT_TIMEOUT_SEC=3"
Environment="XUI_READ_TIMEOUT_SEC=4"
Environment="XUI_HTTP_RETRIES=0"
Environment="XUI_FAST_RETRIES=0"
Environment="READ_ONLY_MODE=false"
Environment="SUB_RATE_LIMIT_COUNT=30"
Environment="SUB_RATE_LIMIT_WINDOW_SEC=60"
Environment="TRAFFIC_STATS_CACHE_TTL=20"
Environment="TRAFFIC_STATS_STALE_TTL=120"
Environment="CLIENTS_CACHE_TTL=20"
Environment="CLIENTS_CACHE_STALE_TTL=180"
Environment="TRAFFIC_MAX_WORKERS=6"
Environment="COLLECTOR_BASE_INTERVAL_SEC=5"
Environment="COLLECTOR_MAX_INTERVAL_SEC=300"
Environment="COLLECTOR_MAX_PARALLEL=4"
Environment="COLLECTOR_WARMING_INTERVAL_1_SEC=30"
Environment="COLLECTOR_WARMING_INTERVAL_2_SEC=60"
Environment="COLLECTOR_WARMING_INTERVAL_3_SEC=60"
Environment="COLLECTOR_ACTIVE_INTERVAL_SEC=60"
Environment="COLLECTOR_IDLE_INTERVAL_SEC=60"
Environment="COLLECTOR_ULTRA_IDLE_INTERVAL_SEC=86400"
Environment="COLLECTOR_IDLE_AFTER_SEC=900"
Environment="COLLECTOR_ULTRA_IDLE_AFTER_SEC=86400"
Environment="AUDIT_QUEUE_BATCH_SIZE=200"
Environment="ROLE_VIEWERS="
Environment="ROLE_OPERATORS="
Environment="MFA_TOTP_ENABLED=false"
Environment="MFA_TOTP_WS_STRICT=false"
Environment="LOG_LEVEL=INFO"
Environment="LOG_FILE=/opt/sub-manager/logs/app.log"
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=true
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/opt/sub-manager
ExecStartPre=/bin/sh -ec 'if /usr/bin/ss -ltnH "sport = :666" | /usr/bin/grep -q .; then echo "Refusing to start: APP_PORT 666 is already in use" >&2; exit 1; fi'
ExecStart=/opt/sub-manager/venv/bin/uvicorn main:app --host 127.0.0.1 --port 666 --log-level warning
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
